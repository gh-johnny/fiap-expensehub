# ExpenseHub — local runtime configuration for Docker Compose.
# `make env` copies this file to .env and replaces every CHANGE_ME with a random value.
# .env is ignored by Git: never commit real credentials.

# Sole bootstrap Admin account (created once by the API seed).
SEED_ADMIN_EMAIL=admin@expensehub.local
SEED_ADMIN_PASSWORD=CHANGE_ME

# RabbitMQ credentials shared by the broker, the API publisher and the worker consumer.
RABBITMQ_USER=expensehub
RABBITMQ_PASSWORD=CHANGE_ME

# Published images (compose.release.yaml): full SHA of the commit published by the release workflow.
IMAGE_TAG=

# Host ports.
API_PORT=5080
RABBITMQ_MANAGEMENT_PORT=15672
